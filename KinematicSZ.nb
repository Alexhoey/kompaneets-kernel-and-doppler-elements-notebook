     RowBox[{"KernelElementmpos", "[", 
      RowBox[{"dv", ",", "pv", ",", "l", ",", "lp", ",", 
       RowBox[{"-", "m"}]}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.981109415876189*^9, 3.981109428791327*^9}, 
