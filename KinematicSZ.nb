   RowBox[{"KernelElement", "[", 
    RowBox[{"O\[Nu]", ",", "pv", ",", "li", ",", "lp", ",", "0", ",", "m"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DopplerAv", "[", 
