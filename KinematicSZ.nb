Cell[CellGroupData[{

Cell["Kernel Element Generations (courtesy of Jens Chluba)", "Section",
 CellChangeTimes->{{3.981108623669969*^9, 3.981108630777001*^9}, {
  3.981108991716322*^9, 
  3.981109006483976*^9}},ExpressionUUID->"04179b86-bce9-4a81-af80-\
f916ac2b66ce"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lmaxv", "=", "5"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"set", " ", "value", " ", "for", " ", "kernel", " ", "setup"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kraisef", "[", 
     RowBox[{"d_", ",", "l_", ",", "Klm1f_", ",", "Klm2f_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Sqrt", "[", 
        FractionBox[
         RowBox[{
          RowBox[{"4", 
           RowBox[{"l", "^", "2"}]}], "-", "1"}], 
         RowBox[{"l", "^", "2"}]], "]"}]}], "*", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Gamma]", "*", 
         RowBox[{"Klm1f", "[", "d", "]"}]}], "-", 
        RowBox[{"Klm1f", "[", 
         RowBox[{"d", "-", "1"}], "]"}]}], "p"]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"l", "-", "1"}], "l"], "*", 
      RowBox[{"Sqrt", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"2", "l"}], "+", "1"}], 
        RowBox[{
         RowBox[{"2", "l"}], "-", "3"}]], "]"}], "*", 
      RowBox[{"Klm2f", "[", "d", "]"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kswitchf", "[", 
     RowBox[{"d_", ",", "Klf_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Klf", "[", 
      RowBox[{"2", "-", "d"}], "]"}], "/.", 
     RowBox[{"p", "->", 
      RowBox[{"-", "p"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"K00", "[", "d_", "]"}], ":=", 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Gamma]", "+", "p"}], ")"}], 
        RowBox[{"1", "-", "d"}]], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Gamma]", "-", "p"}], ")"}], 
        RowBox[{"1", "-", "d"}]]}], 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "d"}], ")"}], " ", "p"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K10", "[", "d_", "]"}], ":=", 
    RowBox[{"Kraisef", "[", 
     RowBox[{"d", ",", "1", ",", "K00", ",", "K00"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K01", "[", "d_", "]"}], ":=", 
    RowBox[{"Kswitchf", "[", 
     RowBox[{"d", ",", "K10"}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K11", "[", "d_", "]"}], ":=", 
    RowBox[{"Kraisef", "[", 
     RowBox[{"d", ",", "1", ",", "K01", ",", "K01"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K21", "[", "d_", "]"}], ":=", 
    RowBox[{"Kraisef", "[", 
     RowBox[{"d", ",", "2", ",", "K11", ",", "K01"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K12", "[", "d_", "]"}], ":=", 
    RowBox[{"Kswitchf", "[", 
     RowBox[{"d", ",", "K21"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K22", "[", "d_", "]"}], ":=", 
    RowBox[{"Kraisef", "[", 
     RowBox[{"d", ",", "2", ",", "K12", ",", "K02"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K32", "[", "d_", "]"}], ":=", 
    RowBox[{"Kraisef", "[", 
     RowBox[{"d", ",", "3", ",", "K22", ",", "K12"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K20", "[", "d_", "]"}], ":=", 
    RowBox[{"Kraisef", "[", 
     RowBox[{"d", ",", "2", ",", "K10", ",", "K00"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K02", "[", "d_", "]"}], ":=", 
    RowBox[{"Kswitchf", "[", 
     RowBox[{"d", ",", "K20"}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K30", "[", "d_", "]"}], ":=", 
    RowBox[{"Kraisef", "[", 
     RowBox[{"d", ",", "3", ",", "K20", ",", "K10"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K03", "[", "d_", "]"}], ":=", 
    RowBox[{"Kswitchf", "[", 
     RowBox[{"d", ",", "K30"}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kmmmd1", "[", "m_", "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"\[Gamma]", "^", 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}]}]], 
     RowBox[{"Hypergeometric2F1", "[", 
      RowBox[{
       RowBox[{
        FractionBox["m", "2"], "+", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{
        FractionBox["m", "2"], "+", "1"}], ",", 
       RowBox[{"m", "+", 
        FractionBox["3", "2"]}], ",", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["p", "\[Gamma]"], ")"}], "^", "2"}]}], "]"}]}]}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kmmm", "[", 
     RowBox[{"m_", ",", "d_"}], "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["\[Gamma]", 
       RowBox[{"d", "+", "m"}]]], 
     RowBox[{"Hypergeometric2F1", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"d", "+", "m"}], "2"], ",", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "d", "+", "m"}], ")"}]}], ",", 
       RowBox[{
        FractionBox["3", "2"], "+", "m"}], ",", 
       FractionBox[
        SuperscriptBox["p", "2"], 
        SuperscriptBox["\[Gamma]", "2"]]}], "]"}]}]}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"K20f", "[", "d_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SqrtBox["5"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "p"}], "+", "\[Gamma]"}], ")"}], 
             RowBox[{"1", "-", "d"}]]}], "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"p", "+", "\[Gamma]"}], ")"}], 
            RowBox[{"1", "-", "d"}]]}], ")"}]}], 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "d"}], ")"}], " ", "p"}]]}], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", " ", "p"}]], 
       SqrtBox["15"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "p"]}], 
          SqrtBox["3"], " ", "\[Gamma]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"\[Gamma]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "p"}], "+", "\[Gamma]"}], ")"}], 
                  RowBox[{"1", "-", "d"}]]}], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"p", "+", "\[Gamma]"}], ")"}], 
                 RowBox[{"1", "-", "d"}]]}], ")"}]}], 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", "d"}], ")"}], " ", "p"}]], "-", 
            FractionBox[
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "p"}], "+", "\[Gamma]"}], ")"}], 
                RowBox[{"2", "-", "d"}]]}], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"p", "+", "\[Gamma]"}], ")"}], 
               RowBox[{"2", "-", "d"}]]}], 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"2", "-", "d"}], ")"}], " ", "p"}]]}], ")"}]}], "+", 
         RowBox[{
          FractionBox["1", "p"], 
          SqrtBox["3"], " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"\[Gamma]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "p"}], "+", "\[Gamma]"}], ")"}], 
                  RowBox[{"2", "-", "d"}]]}], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"p", "+", "\[Gamma]"}], ")"}], 
                 RowBox[{"2", "-", "d"}]]}], ")"}]}], 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"2", "-", "d"}], ")"}], " ", "p"}]], "-", 
            FractionBox[
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "p"}], "+", "\[Gamma]"}], ")"}], 
                RowBox[{"3", "-", "d"}]]}], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"p", "+", "\[Gamma]"}], ")"}], 
               RowBox[{"3", "-", "d"}]]}], 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"3", "-", "d"}], ")"}], " ", "p"}]]}], ")"}]}]}], 
        ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.981108722534108*^9, 3.981108791785112*^9}, {
