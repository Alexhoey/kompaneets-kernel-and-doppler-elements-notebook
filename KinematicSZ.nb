       RowBox[{"[", 
        RowBox[{"lp", "+", "1"}], "]"}], "]"}], "/.", 
      RowBox[{"\[Gamma]", "->", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "+", 
         RowBox[{"p", "^", "2"}]}], "]"}]}]}], "/.", 
     RowBox[{"d", "->", "dv"}]}], "/.", 
    RowBox[{"p", "->", "pv"}]}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"m", ">", "0"}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KernelElement", "[", 
