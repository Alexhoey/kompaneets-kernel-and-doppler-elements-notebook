  3.9811095081970882`*^9}},ExpressionUUID->"98bfc43f-9872-4f10-b8b3-\
657c9cb5611c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Scattering", "[", "l_", "]"}], ":=", 
    RowBox[{
     FractionBox[
      RowBox[{"DopplerAv", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "p", ",", "l", ",", "0", ",", "l"}], "]"}], 
      RowBox[{
       RowBox[{"2", "l"}], "+", "1"}]], "+", 
     RowBox[{
      FractionBox["1", "10"], 
      FractionBox[
       RowBox[{"DopplerAv", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "p", ",", "l", ",", "2", ",", "l"}], "]"}], 
       
       RowBox[{
        RowBox[{"2", "l"}], "+", "1"}]]}], "-", "1"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Scattering", " ", "operator", " ", "in", " ", "the", " ", "Cloud", " ", 
    "rest", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Soperator", "[", "l_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"2", "l"}], "+", "1"}], "]"}], "*", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Scattering", "[", "lp", "]"}], "*", 
        RowBox[{"Doppler", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "p\[Beta]", ",", "l", ",", "lp", ",", "0", 
          ",", "0"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"lp", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Multipole", " ", "scattering", " ", "operator", " ", "in", " ", "the", " ",
     "lab", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FullSoperator", ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Soperator", "[", "l", "]"}], "*", 
       RowBox[{"P", "[", "l", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Full", " ", "scattering", " ", "operator", " ", "in", " ", "the", " ", 
    "lab", " ", "rest", " ", "frame"}], " ", 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
  3.981109535417832*^9, {3.981109910085149*^9, 3.981109978449271*^9}, {
