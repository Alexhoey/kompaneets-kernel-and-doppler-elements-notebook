Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"D0l0", "[", 
    RowBox[{"l_", ",", "nmax_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "l"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "l"}], "+", "1"}], ")"}], "*", 
      FractionBox[
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "n"}], "+", "1"}], ")"}]}], 
        RowBox[{"p", "^", 
         RowBox[{"(", 
          RowBox[{"2", "n"}], ")"}]}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}]}], ")"}], "!"}]], "*", 
      FractionBox[
       RowBox[{"FactorialPower", "[", 
        RowBox[{"n", ",", "l"}], "]"}], 
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         RowBox[{"n", "+", "2"}], ",", "l"}], "]"}]], "*", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"O\[Nu]", "^", "2"}], "-", 
         RowBox[{"3", "O\[Nu]"}], "+", "2", "-", 
         RowBox[{"m", 
          RowBox[{"(", 
           RowBox[{"m", "+", "1"}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", 
          RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dl0l", "[", 
    RowBox[{"l_", ",", "nmax_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"O\[Nu]", "^", "2"}], "-", 
      RowBox[{"3", "O\[Nu]"}], "+", "2", "-", 
      RowBox[{"l", 
       RowBox[{"(", 
        RowBox[{"l", "+", "1"}], ")"}]}]}]], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", "l"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "1"}], ")"}], "*", 
       FractionBox[
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "n"}], "+", "1"}], ")"}]}], 
         RowBox[{"p", "^", 
          RowBox[{"(", 
           RowBox[{"2", "n"}], ")"}]}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}]}], ")"}], "!"}]], "*", 
       FractionBox[
        RowBox[{"FactorialPower", "[", 
         RowBox[{"n", ",", "l"}], "]"}], 
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"n", "+", "2"}], ",", "l"}], "]"}]], "*", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"O\[Nu]", "^", "2"}], "-", 
          RowBox[{"3", "O\[Nu]"}], "+", "2", "-", 
          RowBox[{"m", 
           RowBox[{"(", 
            RowBox[{"m", "+", "1"}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", 
           RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",
