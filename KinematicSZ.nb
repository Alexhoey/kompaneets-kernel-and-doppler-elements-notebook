Cell[BoxData[{
 RowBox[{
  RowBox[{"OOf", "[", "k_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "^", "k"}], "*", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"StirlingS2", "[", 
       RowBox[{"k", ",", "m"}], "]"}], "*", 
      RowBox[{"DD", "[", "m", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "1", ",", "k"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ReplOOf", "[", "k_", "]"}], ":=", 
  RowBox[{"Reverse", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"OO", "^", "m"}], "->", 
      RowBox[{"OOf", "[", "m", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "1", ",", 
       RowBox[{"2", "*", "k"}]}], "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Df", "[", "k_", "]"}], ":=", 
  RowBox[{
   RowBox[{"x", "^", "k"}], "*", 
   RowBox[{"D", "[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"Exp", "[", "x", "]"}], "-", "1"}]], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "k"}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9876778983779783`*^9, 
  3.987677960495103*^9}},ExpressionUUID->"df9fffa9-b783-42a0-b83e-\
dfff68067fb1"],

