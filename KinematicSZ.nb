Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "cosharcsinhbygamma", " ", "and", " ", "cosharcsinh", " ", "include", " ", 
    
    RowBox[{"p", "^", 
     RowBox[{"-", "2"}]}], " ", "factor"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"cosharcsinhbygamma", "[", 
      RowBox[{"k_", ",", " ", "q_", ",", "nmax_"}], "]"}], ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "*", 
            RowBox[{"(", 
             RowBox[{"n", "+", "1"}], ")"}]}], ")"}], "!"}]], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "^", "2"}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "m"}], "+", "1"}], ")"}], "^", "2"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "0", ",", "n"}], "}"}]}], "]"}], "-", 
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"q", "^", "2"}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "m"}], "+", "1"}], ")"}], "^", "2"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ")"}], "*", 
        
        RowBox[{"p", "^", 
         RowBox[{"(", 
          RowBox[{"2", "*", "n"}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cosharcsinh", "[", 
      RowBox[{"k_", ",", " ", "q_", ",", "nmax_"}], "]"}], ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
